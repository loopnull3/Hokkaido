<?xml version="1.0" encoding="utf-8"?>
<!-- The console home's design (assets/orbit/index.html) for the app's own widgets: white main buttons, gray filled
     others, round icon buttons as its dock, cards as its tiles and a white ring around what the controller is on.
     The colours come from the theme, so other themes keep theirs. -->
<resources>

    <!-- Buttons: 13dp corners, no capitals, medium weight -->
    <style name="Orbit.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="rippleColor">#33000000</item>
        <item name="cornerRadius">13dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
        <item name="strokeColor">@color/orbit_focus_ring</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Orbit.Button.Secondary">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Orbit.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="cornerRadius">13dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/orbit_focus_ring</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Round icon buttons, as the home's dock -->
    <style name="Orbit.IconButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="strokeColor">@color/orbit_focus_ring</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Orbit.IconButton.Plain" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Cards, as the home's tiles: a #1C1C1E fill, no border until the controller is on them -->
    <style name="Orbit.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/orbit_focus_ring</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">#1FFFFFFF</item>
    </style>

    <!-- Titles: large and left, as the home's game name -->
    <style name="Orbit.TextAppearance.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Orbit.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/Orbit.TextAppearance.Title</item>
        <item name="titleCentered">false</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Orbit.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/orbit_switch_thumb</item>
        <item name="trackTint">@color/orbit_switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <!-- Floating buttons: round and dark as the dock; the extended one white as the main button -->
    <style name="Orbit.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="tint">?attr/colorOnSurface</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
    </style>

    <style name="Orbit.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="rippleColor">#33000000</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Text fields: a filled rounded box, no underline -->
    <style name="Orbit.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">13dp</item>
        <item name="boxCornerRadiusTopEnd">13dp</item>
        <item name="boxCornerRadiusBottomStart">13dp</item>
        <item name="boxCornerRadiusBottomEnd">13dp</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Orbit.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">13dp</item>
        <item name="boxCornerRadiusTopEnd">13dp</item>
        <item name="boxCornerRadiusBottomStart">13dp</item>
        <item name="boxCornerRadiusBottomEnd">13dp</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Orbit.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">?attr/colorOnSurface</item>
        <item name="trackColor">?attr/colorSurfaceContainerHigh</item>
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
    </style>

    <style name="Orbit.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Bottom sheets, as the home's sheet -->
    <style name="Orbit.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="shapeAppearance">@style/Orbit.Shape.Sheet</item>
    </style>

    <style name="Orbit.Shape.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Orbit.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Orbit.BottomSheet</item>
    </style>

    <style name="Orbit.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/orbit_popup_background</item>
    </style>
</resources>
