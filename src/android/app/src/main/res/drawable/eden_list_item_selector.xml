<?xml version="1.0" encoding="utf-8"?>
<!-- A row as the console home's tiles: a rounded fill, a lighter one pressed, a white ring where the controller is -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eden_card_background_elevated" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eden_card_background" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/eden_on_surface" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/eden_card_background" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/eden_on_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eden_card_background" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
