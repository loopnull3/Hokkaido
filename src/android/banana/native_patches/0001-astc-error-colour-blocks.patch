+static uint16_t half_unorm16(uint16_t h) {   // an FP16 value clamped to [0, 1], as UNORM16
+    uint32_t e = h >> 10 & 31, m = h & 1023;
+    if ((h & 0x8000) || (e == 31 && m)) return 0;   // negative, NaN
+    if (e >= 15) return 0xFFFF;   // 1 and above, infinity
+    if (!e) return (uint16_t)(((uint64_t)m * 65535 + (1u << 23)) >> 24);   // subnormal: m / 2^24
+    uint32_t u = (e + 112) << 23 | m << 13; float f; memcpy(&f, &u, 4);
+    return (uint16_t)(f * 65535.0f + 0.5f);
+}
+// Blocks a Switch never samples as the error colour but this driver does, in place: an all-zero block (storage the guest left unmapped or unwritten:
+// a tail of levels, a hole in a pool) becomes the void-extent block of 0, and an HDR void-extent block (no ASTC HDR profile on RADV / Xclipse) the LDR
+// one of its colour clamped to [0, 1]. Every upload of an ASTC texture from guest storage goes through it
+static _Atomic uint64_t g_astc_zero, g_astc_hdr;
+static void astc_clean(VkFormat v, uint8_t *p, size_t n) {
+    if (!is_astc(v)) return;
+    uint64_t nz = 0, nh = 0;
+    for (size_t i = 0; i + 16 <= n; i += 16) {
+        uint64_t a, b; memcpy(&a, p + i, 8); memcpy(&b, p + i + 8, 8);
+        if (!(a | b)) { memcpy(p + i, k_astc_zero, 16); nz++; continue; }
+        if ((a & 0xDFF) != 0xDFC || !(a & 0x200)) continue;   // void-extent: bits 0-8 0x1FC, 10-11 set; bit 9 HDR
+        uint64_t c = 0; for (int k = 0; k < 4; k++) c |= (uint64_t)half_unorm16((uint16_t)(b >> 16 * k)) << 16 * k;
+        a &= ~(uint64_t)0x200; memcpy(p + i, &a, 8); memcpy(p + i + 8, &c, 8); nh++;
+    }
+    static _Atomic int once; if (!atomic_exchange(&once, 1)) VLOG("ASTC uploads: all-zero blocks become zero texels, HDR void-extent blocks LDR ones (Hokkaido)");
+    if (!nz && !nh) return;
+    uint64_t z0 = atomic_fetch_add(&g_astc_zero, nz), h0 = atomic_fetch_add(&g_astc_hdr, nh), z1 = z0 + nz, h1 = h0 + nh;
+    if (63 - __builtin_clzll(z1 | 1) != 63 - __builtin_clzll(z0 | 1) || 63 - __builtin_clzll(h1 | 1) != 63 - __builtin_clzll(h0 | 1))   // a line per power of two crossed
+        VLOG("ASTC uploads: %llu all-zero blocks made zero texels, %llu HDR void-extent blocks made LDR so far (format %d, this upload %llu / %llu of %zu)",
+             (unsigned long long)z1, (unsigned long long)h1, (int)v, (unsigned long long)nz, (unsigned long long)nh, n / 16);
 }
