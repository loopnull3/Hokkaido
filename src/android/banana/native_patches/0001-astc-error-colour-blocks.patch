+    return (uint16_t)(f * 65535.0f + 0.5f);
+}
+// Blocks a Switch never samples as the error colour but this driver does, in place: an all-zero block (storage the guest left unmapped or unwritten:
+// a tail of levels, a hole in a pool) becomes the void-extent block of 0, and an HDR void-extent block (no ASTC HDR profile on RADV / Xclipse) the LDR
+// one of its colour clamped to [0, 1]. Every upload of an ASTC texture from guest storage goes through it
+static _Atomic uint64_t g_astc_zero, g_astc_hdr;
+size_t hk_astc_hdr_to_ldr(uint8_t *data, size_t n, unsigned bw, unsigned bh, int srgb);   // vka_astc_hdr.cpp
+static void astc_clean(VkFormat v, uint8_t *p, size_t n) {
+    if (!is_astc(v)) return;
+    static const uint8_t dims[14][2] = {{4, 4}, {5, 4}, {5, 5}, {6, 5}, {6, 6}, {8, 5}, {8, 6}, {8, 8}, {10, 5}, {10, 6}, {10, 8}, {10, 10}, {12, 10}, {12, 12}};
+    unsigned k = (unsigned)(v - VK_FORMAT_ASTC_4x4_UNORM_BLOCK);
+    uint64_t nz = 0, nh = 0;
+    for (size_t i = 0; i + 16 <= n; i += 16) {
+        uint64_t a, b; memcpy(&a, p + i, 8); memcpy(&b, p + i + 8, 8);
+        if (!(a | b)) { memcpy(p + i, k_astc_zero, 16); nz++; continue; }
+        if ((a & 0xDFF) != 0xDFC || !(a & 0x200)) continue;   // void-extent: bits 0-8 0x1FC, 10-11 set; bit 9 HDR
+        uint64_t c = 0; for (int k = 0; k < 4; k++) c |= (uint64_t)half_unorm16((uint16_t)(b >> 16 * k)) << 16 * k;
+        a &= ~(uint64_t)0x200; memcpy(p + i, &a, 8); memcpy(p + i + 8, &c, 8); nh++;
+    }
+    nh += hk_astc_hdr_to_ldr(p, n / 16, dims[k / 2][0], dims[k / 2][1], (int)(k & 1));   // blocks of HDR endpoint modes: decoded and encoded as LDR
+    static _Atomic int once; if (!atomic_exchange(&once, 1)) VLOG("ASTC uploads: all-zero blocks become zero texels, HDR blocks LDR ones (Hokkaido)");
+    if (!nz && !nh) return;
